# Google Cloud / Vertex AI Configuration (Required)
# Enable the Vertex AI API in your GCP project: https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
# Authentication options:
#   Local development: run `gcloud auth application-default login`
#   Or set GOOGLE_APPLICATION_CREDENTIALS to your service account JSON file path
#   Cloud/Railway deployment: paste the entire service account JSON content into GOOGLE_APPLICATION_CREDENTIALS_JSON
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# GCP Service Account JSON for cloud deployments (Railway, Render, etc.)
# Paste the full contents of your service account JSON file here
# NEVER commit the actual value to git — set this in your deployment platform's env variables
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Gemini Model Configuration (served via Vertex AI)
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cartesia TTS API Key (Required)
# Sign up at: https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=your_cartesia_voice_id_here

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Google Cloud Storage (Optional - only required for deployment)
# For local development, videos will be saved to the ./output directory
GCS_BUCKET_NAME=your-gcs-bucket-name
